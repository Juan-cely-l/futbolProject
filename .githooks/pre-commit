#!/bin/sh
#
# Futbix Pre-commit Hook
# =======================
# Runs validation checks before each commit.
#
# Installed automatically by `scripts/setup-hooks.sh`
# To bypass: git commit --no-verify

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'
BOLD='\033[1m'

echo ""
echo "${CYAN}⚡ Futbix pre-commit hook${NC}"
echo "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

STAGED_JAVA=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.java$' || true)
STAGED_FRONTEND=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|jsx|ts|tsx|css)$' | grep '^frontend/' || true)
STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACMR || true)

FAILED=0

# ── 1. Check for problematic patterns ──────────────────────────────────

if echo "$STAGED_FRONTEND" | grep -q .; then
    CONSOLE_LOGS=$(git diff --cached -U0 -- frontend/ | grep '^+.*console\.log' || true)
    if [ -n "$CONSOLE_LOGS" ]; then
        echo "${YELLOW}⚠  Warning: console.log found in staged frontend files:${NC}"
        echo "$CONSOLE_LOGS" | while read -r line; do echo "   $line"; done
        echo ""
    fi

    FIXMES=$(git diff --cached -U0 -- frontend/ | grep -E '^+.*(FIXME|TODO)' || true)
    if [ -n "$FIXMES" ]; then
        echo "${YELLOW}⚠  Reminder: FIXME/TODO markers in staged frontend files:${NC}"
        echo "$FIXMES" | while read -r line; do echo "   $line"; done
        echo ""
    fi
fi

# ── 2. ESLint for frontend changes ─────────────────────────────────────

if echo "$STAGED_FRONTEND" | grep -q .; then
    echo "${CYAN}📦 Checking frontend code quality...${NC}"
    cd frontend

    # Check if eslint is configured — if not, install it
    if [ ! -f "eslint.config.js" ] && [ ! -f ".eslintrc.cjs" ]; then
        echo "${YELLOW}   ESLint not configured yet. Run scripts/setup-hooks.sh to initialize.${NC}"
    fi

    cd ..
fi

# ── 3. Compile backend if Java files changed ───────────────────────────

if echo "$STAGED_JAVA" | grep -q .; then
    echo "${CYAN}☕  Verifying backend compilation...${NC}"
    if ! mvn compile -q -B 2>/dev/null; then
        echo "${RED}✘ Backend compilation failed.${NC}"
        FAILED=1
    else
        echo "${GREEN}✓  Backend compiles successfully${NC}"
    fi
fi

# ── 4. Run backend tests if Java source files changed (non-blocking) ────

if echo "$STAGED_JAVA" | grep -q .; then
    echo "${CYAN}🧪 Running backend tests...${NC}"
    if ! mvn test -q -B 2>/dev/null; then
        echo "${YELLOW}⚠  Backend tests failed. Check details above.${NC}"
        # Not blocking — compile passed, tests are extra safety
    else
        echo "${GREEN}✓  Backend tests pass${NC}"
    fi
fi

# ── 5. Build frontend if frontend files changed ────────────────────────

if echo "$STAGED_FRONTEND" | grep -q .; then
    echo "${CYAN}🎨 Verifying frontend build...${NC}"
    if ! cd frontend && npm run build -- --logLevel error 2>/dev/null && cd ..; then
        echo "${RED}✘ Frontend build failed.${NC}"
        cd ..
        FAILED=1
    else
        echo "${GREEN}✓  Frontend builds successfully${NC}"
    fi
fi

# ── 6. Check for large files being committed ───────────────────────────

for file in $STAGED_ALL; do
    SIZE=$(git diff --cached -- "$file" | wc -c)
    if [ "$SIZE" -gt 500000 ] 2>/dev/null; then
        echo "${YELLOW}⚠  Large diff detected in $file (${SIZE} bytes)${NC}"
    fi
done

# ── 7. Secret scanning ──────────────────────────────────────────────────

SECRET_PATTERNS='sk-[A-Za-z0-9]{20,}|-----BEGIN (RSA |EC )?PRIVATE KEY|ghp_[A-Za-z0-9]{36,}|gho_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9]{22,}|AKIA[0-9A-Z]{16}|SFMY[0-9A-Z]{16}|xox[abprs]-[A-Za-z0-9-]{10,}'

SECRET_FILES=$(echo "$STAGED_ALL" | grep -E '\.(java|js|jsx|ts|tsx|py|properties|yml|yaml|sh|env)$' || true)

if echo "$SECRET_FILES" | grep -q .; then
    SECRETS_FOUND=$(git diff --cached -U0 -- "$SECRET_FILES" 2>/dev/null | grep -E "^\+.*($SECRET_PATTERNS)" || true)
    if [ -n "$SECRETS_FOUND" ]; then
        echo "${RED}✘ Potential secret(s) detected in staged changes:${NC}"
        echo "$SECRETS_FOUND" | while read -r line; do
            # Mask the secret for display
            MASKED=$(echo "$line" | sed -E "s/($SECRET_PATTERNS)/\1...REDACTED/" 2>/dev/null || echo "$line")
            echo "   $MASKED"
        done
        echo ""
        echo "${RED}✘ Remove secrets before committing. Use .env files or env vars.${NC}"
        FAILED=1
    fi
fi

# ── 8. Gitleaks secret scanning ──────────────────────────────────────────

if command -v gitleaks &> /dev/null; then
    if ! gitleaks detect --no-git --source . --no-banner 2>/dev/null; then
        echo "${RED}✘ Secrets detected by gitleaks${NC}"
        FAILED=1
    fi
fi

# ── Summary ────────────────────────────────────────────────────────────

echo ""
if [ "$FAILED" -ne 0 ]; then
    echo "${RED}${BOLD}✘  Pre-commit checks failed. Fix the errors and try again.${NC}"
    echo "${YELLOW}   To skip: git commit --no-verify${NC}"
    exit 1
else
    echo "${GREEN}${BOLD}✓  All pre-commit checks passed${NC}"
fi
